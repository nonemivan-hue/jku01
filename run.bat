@echo off
REM ============================================
REM  Запуск программы (нужен Python 3.10+)
REM  При первом запуске недостающие модули
REM  устанавливаются автоматически
REM ============================================
cd /d "%~dp0"
py -3 app.py 2>nul || python app.py
if errorlevel 1 pause
